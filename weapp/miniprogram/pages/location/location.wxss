.map-card {
  padding: 0;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 520rpx;
}

.map-empty {
  height: 300rpx;
  line-height: 300rpx;
}

.seg {
  display: flex;
  background: #11161D;
  border: 1rpx solid #242C38;
  border-radius: 18rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 18rpx 8rpx;
  border-radius: 14rpx;
  color: #8B95A7;
  line-height: 1.35;
}

.seg-on {
  background: #3DF5C8;
  color: #06231C;
  font-weight: 600;
}

.seg-hint {
  margin-top: 16rpx;
  line-height: 1.6;
}
