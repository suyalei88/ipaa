# ============================================================
#  换行符 / 二进制属性
#
#  关键：build_ipa.sh 在 macOS 上必须是 LF。
#  Windows 上 git 默认 autocrlf 会把文本转成 CRLF，
#  这里显式钉死 eol=lf，保证 clone 到任何平台都是 LF。
# ============================================================

* text=auto eol=lf

# 脚本 / 工程文件：必须 LF
*.sh            text eol=lf
*.bash          text eol=lf
*.pbxproj       text eol=lf
*.xcscheme      text eol=lf
*.plist         text eol=lf
*.swift         text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.js            text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制：不要碰
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ipa           binary
*.apk           binary
*.har           binary
*.zip           binary
*.dex           binary
