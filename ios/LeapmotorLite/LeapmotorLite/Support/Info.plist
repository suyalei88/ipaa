<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>零跑轻控</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- ★ 每次交付新包都要改这两个值，否则用户无法分辨新旧包
	     （2026-10-07 踩过：两版都是 1.0.0 (1)，用户装完说「跟上个版本一样」）。
	     改完顺便把 LMBuildInfo.tag 也改掉，那里是给人看的说明。 -->
	<key>CFBundleShortVersionString</key>
	<string>1.0.7</string>
	<key>CFBundleVersion</key>
	<string>8</string>

	<!-- 构建指纹：由 ios/build_ipa.sh 在打包时注入（git 提交号 + UTC 构建时刻）。
	     这是「这一版到底是哪一次构建」的最终判据 —— 手工改版本号总会忘，
	     提交号不会。用 Xcode 直接跑（不走 build_ipa.sh）时这两个值不会被替换，
	     LMBuildInfo 会把「以 $( 开头」的值识别为未注入并显示成「本地构建」。 -->
	<key>LMGitSHA</key>
	<string>$(LM_GIT_SHA)</string>
	<key>LMBuildTime</key>
	<string>$(LM_BUILD_TIME)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 空的 UILaunchScreen = 系统默认白底启动图。
	     不要填 UIColorName（asset 里没有对应颜色会起不来）。 -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- 全部接口均为 HTTPS，无需 ATS 例外。
	     ★ 唯一的例外是「3D 看车」：官方车模查看器（three.js）必须在 Web Worker 里
	       解析 FBX，WKWebView 对 file:// 页面按唯一不透明源处理，Worker/XHR 都会被拦，
	       所以由 Car3DServer 在 127.0.0.1 上起一个只服务 App 内 Car3D/ 目录的本地 HTTP 服务。
	       NSAllowsLocalNetworking 只放开「本地/回环」地址，不放开任意公网明文 HTTP。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 「车辆定位」页里算「距我多远」要读本机位置。
	     只有用户点「获取我的位置」时才请求；拒绝也只是不显示距离，不影响其它功能。 -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于在地图上显示你与车辆之间的距离。仅在你点击「获取我的位置」时读取，不会上传、不用于任何其他用途。</string>

	<!-- 蓝牙钥匙 / BLE 调试台。权限只在打开「蓝牙钥匙」或「BLE 调试台」时才请求
	     （LMBLECentral 是懒初始化的，App 启动不会弹窗）。
	     官方 App 的用途说明写的是「用于蓝牙钥匙、自动泊车」，我们只做前者。 -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>用于连接车辆的蓝牙模块，读取车况与调试蓝牙钥匙协议。不会连接非本车的设备，不上传任何扫描结果。</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>用于连接车辆的蓝牙模块，读取车况与调试蓝牙钥匙协议。</string>

	<!-- bluetooth-central：App 被切到后台后仍能保持/恢复与车的 BLE 连接。
	     ★ 刻意不加 bluetooth-peripheral —— 官方那条是为了自动泊车把自己做成外设，
	       我们不需要，加上只会多一份后台能力说明。
	     注意 iOS 对后台 BLE 有节流，别指望秒级实时。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
