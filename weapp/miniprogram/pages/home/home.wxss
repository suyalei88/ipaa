.hero {
  padding-top: 34rpx;
}

.hero-top {
  display: flex;
  align-items: center;
}

/* 电量环：外圈用 conic-gradient 画进度，内圈盖住做成圆环 */
.ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-inner {
  width: 218rpx;
  height: 218rpx;
  border-radius: 50%;
  background: #151A22;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.soc {
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #E8EDF5;
}

.soc-unit {
  font-size: 26rpx;
  color: #8B95A7;
  margin-left: 4rpx;
}

.hero-right {
  flex: 1;
  margin-left: 34rpx;
}

.stat-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 10rpx 0;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
}

.unit {
  font-size: 22rpx;
  color: #8B95A7;
  margin-left: 6rpx;
}

.vin {
  margin-top: 6rpx;
}

.coord-note {
  margin-top: 6rpx;
  color: #FFB454;
}

/* 磁贴 */
.tile {
  background: #11161D;
  border: 1rpx solid #1E252F;
  border-radius: 18rpx;
  padding: 20rpx;
}

.tile-label {
  font-size: 23rpx;
  color: #8B95A7;
}

.tile-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}
